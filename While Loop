# add the singular of remediation device variable for next time 

compliant_device = 0
non_compliant_device = 0
remediation_devices = []
non_supported_device = 0
continue_checking = "yes"

while continue_checking == "yes":
    print("Checking devices")
    device_name = input("Input device name: ")
    device_osversion = int(input("Input OS Version number: "))

    if device_osversion < 10:
        non_supported_device = non_supported_device + 1
        remediation_devices.append(device_name)
        print(f"{device_name} OS version not supported")
        #continue_checking = input("Check another device? ").lower()


    elif device_osversion == 10:
        non_compliant_device = non_compliant_device + 1
        remediation_devices.append(device_name)
        print(f"{device_name} Non-Compliant")
        #continue_checking = input("Check another device? ").lower()


    elif device_osversion == 11:
        compliant_device = compliant_device + 1
        print(f"{device_name} Compliant")
        #continue_checking = input("Check another device? ").lower()


    else:
        non_supported_device = non_supported_device + 1
        remediation_devices.append(device_name)
        print(f"{device_name} OS version not supported")

    continue_checking = input("Check another device? ").lower()


total_devices = compliant_device + non_compliant_device + non_supported_device
compliance_rate = (compliant_device / total_devices) * 100 
non_compliance_rate = (non_compliant_device / total_devices) * 100 
non_supported_rate = (non_supported_device / total_devices) * 100

print(f"Devices Checked: {total_devices}")
print(f"Compliant Devices: {compliant_device}")
print(f"Non-Compliant Devices: {non_compliant_device}")
print(f"Non-Supported Devices: {non_supported_device}")
print(f"Compliance Rate: {compliance_rate}")
print(f"Non-Compliance Rate: {non_compliance_rate}")
print(f"Non-Supported Rate: {non_supported_rate}")

print("Devices Requiring Remediation:")
for remediation_devices in remediation_devices:
    print(f"{remediation_devices}")