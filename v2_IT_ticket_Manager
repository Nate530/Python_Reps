enter_ticket = "yes"
low_sev = 0
med_sev = 0
high_sev = 0
escalation = ""
escalated_tickets = []


while enter_ticket == "yes":
    print("Enter Ticket Information")
    current_ticket_sev = ""
    employee_name = input("Enter employee name: ")
    affected_users = int(input("How many users are affected?: "))
    device_compliance = input("Is the device compliant?: ").lower()

    if affected_users <= 0:
        print("Invalid Information")

    elif affected_users <= 10:
        low_sev = low_sev + 1
        current_ticket_sev = "Low"
        require_escalation = "No"

    elif affected_users <= 50:
        med_sev = med_sev + 1
        current_ticket_sev = "Medium"
        require_escalation = "No"

    elif affected_users >= 51:
        high_sev = high_sev + 1
        current_ticket_sev = "High"

    if device_compliance == "no" or current_ticket_sev == "High":
        require_escalation = "Yes"
        escalation = employee_name
        escalated_tickets.append(escalation)

    print(f"Ticket Summary")
    print(f"{employee_name}")
    print(f"Affected Users: {affected_users}")
    print(f"Device Compliant: {device_compliance}")
    print(f"Ticket Severity : {current_ticket_sev}")
    print(f"Escalation: {require_escalation} ")

    enter_ticket = input("Enter another ticket: ").lower()


tickets_processed = low_sev + med_sev + high_sev
high_severity_rate = (high_sev / tickets_processed) * 100


print("IT Support Summary")
print(f"Tickets Processed {tickets_processed}")
print(f"Low Severity: {low_sev}")
print(f"Medium Severity: {med_sev}")
print(f"High Severity: {high_sev}")
print(f"High Severity Rate: {high_severity_rate}")
 #print(len(escalated_tickets))
print(f"Total Escalations {len(escalated_tickets)}")
print("Employees Requiring Escalation")
for escalation in escalated_tickets:
    print(f"{escalation}")